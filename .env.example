# ===== COC Control — producao (copie para .env e edite) =====

# Login (OBRIGATORIO na VPS)
ADMIN_USER=chris
# gere com: python tools/hash_password.py  (ou defina ADMIN_PASSWORD em texto)
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=troque-esta-senha

# Chave de sessao (gere com: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# Atras de proxy reverso com HTTPS? (cookies Secure)
COC_HTTPS=1
COC_BEHIND_PROXY=1

# Fuso horario (resumo diario e datas)
TZ=America/Sao_Paulo

# ---- Clash Labs (assinantes, opcional) ----
# Com as duas primeiras preenchidas, quem assina o passe do COC Control na vitrine
# entra com a conta da Clash Labs e ganha as próprias vilas. O login acima é o dono.
# LABS_PRODUCT_SECRET é o mesmo valor de PRODUCT_COC_CONTROL_SECRET na vitrine
# (48+ caracteres: python -c "import secrets;print(secrets.token_urlsafe(48))").
LABS_URL=
LABS_PRODUCT_SECRET=
# endereço interno da vitrine, se o servidor alcança ela por outra rota
LABS_API_URL=
# segundos entre as conferências dos passes (rede de segurança do aviso da vitrine)
LABS_SYNC_INTERVAL=900
# limites de cada assinante (o dono não tem)
COC_MAX_ACCOUNTS=20
COC_MAX_SNAPSHOTS=150
# Privacidade/admin são recursos internos do produto; não exigem novas variáveis.
# O banco é copiado automaticamente antes de migração de schema.
